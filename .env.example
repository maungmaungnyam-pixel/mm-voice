# Local development template. Copy this file to .dev.vars for Wrangler.
# Replace every placeholder locally; never commit .dev.vars or a real .env file.
# Cloudflare Workers do not read this file automatically; see README.md.

# Required for the admin login.
ADMIN_PASSWORD=replace-with-a-unique-long-random-password

# Optional Gemini integrations: news editorial pipeline and Burmese text-to-speech.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_TTS_API_KEY=replace-with-your-gemini-api-key

# Optional social-login providers. Set both values for a provider to enable it.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
LINE_CHANNEL_ID=replace-with-line-login-channel-id
LINE_CHANNEL_SECRET=replace-with-line-login-channel-secret
